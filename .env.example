# Requis pour le build et l'exécution (Vercel : Project Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Serveur (API, webhooks, cron)
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=

# IA (OpenAI — serveur uniquement, ne jamais exposer côté client)
OPENAI_API_KEY=
# Optionnel — défaut ZenGrow : gpt-5.4-mini
OPENAI_MODEL=
# Auth Google : ajouter dans Supabase Redirect URLs :
#   http://localhost:3000/auth/callback
#   ${NEXT_PUBLIC_SITE_URL}/auth/callback
# Comptes fondateur SaaS (limites IA élevées) — serveur uniquement, séparés par des virgules
FOUNDER_EMAILS=goffinetvalentin05@gmail.com

# Apple Wallet (.pkpass) — secrets serveur uniquement, jamais NEXT_PUBLIC_
# Pass Type ID créé dans Apple Developer (ex. pass.ch.zengrow.giftvoucher)
APPLE_WALLET_PASS_TYPE_ID=
# Team ID Apple Developer (10 caractères)
APPLE_WALLET_TEAM_ID=
# Certificat Pass Type ID exporté en PEM (contenu, ou base64). Ne pas exposer au navigateur.
APPLE_WALLET_SIGNER_CERT=
APPLE_WALLET_SIGNER_KEY=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
# APNs (AuthKey .p8) — obligatoire pour actualiser le solde après un encaissement partiel
APPLE_WALLET_APNS_KEY_ID=
APPLE_WALLET_APNS_KEY=
