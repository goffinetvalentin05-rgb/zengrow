# Requis pour le build et l'exécution (Vercel : Project Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domaine affiché pour les liens publics courts (ex. sharpz.me/valentin). Configurable.
# En local, Copy / Share utilise l’origine courante (localhost) pour que le lien ouvre vraiment le profil.
# NEXT_PUBLIC_SHARPZ_LINK_HOST=sharpz.me
# Optionnel alias legacy (sinon NEXT_PUBLIC_SITE_URL)
# NEXT_PUBLIC_APP_URL=

# Serveur (API, webhooks, cron) — Production / Preview Vercel UNIQUEMENT
# Ne jamais préfixer NEXT_PUBLIC_ — jamais committer de secrets
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Sharpz Pro (discovery) — create a Stripe Price around 9.90 / month
STRIPE_SHARPZ_PRO_PRICE_ID=
# Legacy restaurant Pro price (kept for old billing webhooks)
STRIPE_PRO_PRICE_ID=
STRIPE_STARTER_PRICE_ID=

# Local only: allow POST /api/discovery/dev-seed to insert fictional profiles
# DISCOVERY_ALLOW_SEED=1
RESEND_API_KEY=

# Cron (CRITIQUE prod) — sans cette clé, les routes /api/cron/* refusent (503)
# Vercel Cron envoie Authorization: Bearer $CRON_SECRET automatiquement
CRON_SECRET=

# IA (OpenAI — serveur uniquement, ne jamais exposer côté client)
# Configurer sur Vercel (Production + Preview)
OPENAI_API_KEY=
# Optionnel — défaut ZenGrow : gpt-5.4-mini
OPENAI_MODEL=

# Recherche Prospects + Concurrents (serveur uniquement)
# Si défini : UNIQUEMENT ce provider (pas de fallback silencieux). Valeurs : tavily | serper | brave
# PROSPECT_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- E2E P0.1 remote (machine locale → API Vercel) ---
# Aucun secret serveur requis ici. Les tools s’exécutent sur Vercel.
# E2E_BASE_URL=https://votre-app.vercel.app
# E2E_COOKIE=...   # Cookie session après login navigateur sur cette URL
# E2E_EMAIL=       # alternative à E2E_COOKIE (compte test)
# E2E_PASSWORD=
# E2E_PERSIST=1    # optionnel : confirme aussi POST/PATCH après propositions
# Auth Google : ajouter dans Supabase Redirect URLs :
#   http://localhost:3000/auth/callback
#   ${NEXT_PUBLIC_SITE_URL}/auth/callback
# Comptes fondateur SaaS (limites IA élevées) — serveur uniquement, séparés par des virgules
FOUNDER_EMAILS=

# Apple Wallet (.pkpass) — secrets serveur uniquement, jamais NEXT_PUBLIC_
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_SIGNER_CERT=
APPLE_WALLET_SIGNER_KEY=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
APPLE_WALLET_APNS_KEY_ID=
APPLE_WALLET_APNS_KEY=
