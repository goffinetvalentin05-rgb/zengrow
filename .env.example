# Requis pour le build et l'exécution (Vercel : Project Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Serveur (API, webhooks, cron)
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=

# IA (OpenAI — serveur uniquement, ne jamais exposer côté client)
OPENAI_API_KEY=
# Optionnel — défaut : gpt-5.4-mini
OPENAI_MODEL=
# Style Profile : openai (si clé présente) ou mock
STYLE_AI_PROVIDER=
STYLE_VISION_MODEL=
STYLE_IMAGE_MODEL=gpt-image-1
# Prix one-time Style Profile en centimes (défaut 790 = 7,90 CHF)
STRIPE_STYLE_PROFILE_AMOUNT=790
STRIPE_STYLE_PROFILE_CURRENCY=chf
# Comptes fondateur SaaS (limites IA élevées) — serveur uniquement, séparés par des virgules
FOUNDER_EMAILS=goffinetvalentin05@gmail.com
